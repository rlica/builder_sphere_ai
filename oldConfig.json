{
  "align": {
    "eliteSigma": 0.1,
    "eliteSteps": 2,
    "histBins": 3000,
    "histRange": [70, 3700],
    "objectiveFunc": "pearson",
    "outFileName": "align",
    "paraLimits": [ [-20, 20], [0.8, 1.2] ],
    "population": 20,
    "refFile": "238U_TAC_0703_000003.cap",
    "selection": [1, 1, 0.1],
    "steps": 20
  },
  "convert": {
    "root": {"addHistogram": true, "addList": true, "addRunTime": true}
  },
  "build": {
    "absoluteTime": {"resetGap": 5, "scalePower": -12},
    "antiCoincFlag": [3],
    "coincMask": [ [1, 0, 1], [0, 1, 1], [1, 0, 0], [0, 1, 0] ],
    "coincWindow": 1000,
    "sortBeforeBuild": true,
    "typePriority": [0, 1, 2]
  },
  "delay": {
    "energyThreshold": 50,
    "histBins": 4000,
    "histRange": [0, 40000],
    "outFileName": "results",
    "refLUT": 0,
    "refTimeOffset": -20000,
    "refType": 5
  },
  "detector": {
    "coincPairs": [ [  0,   1, 2] ],
    "delay"     : [ [-42, -47, 0] ],
    "lut"       : [ [  0,   0, 0] ],
    "type"      : [ [  0,   1, 2] ]
  },
  "gasp": {
    "detectors": {
      "bgo": {"dataType": [], "type": []},
      "dErings": {
        "dataType": ["energy", "time/1000", "time%1000"],
        "type"    : [1       , 1          , 1          ]
      },
      "dEsectors": {
        "dataType": ["energy", "time/1000", "time%1000"],
        "type"    : [0       , 0          , 0          ]
      },
      "eRings": {
        "dataType": ["energy", "time/1000", "time%1000"],
        "type"    : [3       , 3          , 3          ]
      },
      "eSectors": {
        "dataType": ["energy", "time/1000", "time%1000"],
        "type"    : [2       , 2          , 2          ]
      },
      "hpgeBGO": {
        "dataType": [
          "energy"   , "time/1000", "time%1000", "energy"   , "time/1000",
          "time%1000"
        ],
        "type": [6, 6, 6, 4, 4, 4]
      },
      "labr": {
        "dataType": [
          "energy"   , "time/1000", "time%1000", "energy"   , "time/1000",
          "time%1000"
        ],
        "type": [5, 5, 5, 4, 4, 4]
      }
    },
    "typeOutputFormat": [
      "dEsectors", "dErings"  , "eSectors" , "eRings"   , "bgo"      ,
      "labr"     , "hpgeBGO"
    ]
  },
  "general": {"maxCores": 20, "run": "build", "timeUnitMultiplier": 1000},
  "input": {
    "eventCount": 0,
    "fileFormat": "cap",
    "fileIdentifier": "60Co",
    "keepIndex": [0, 100],
    "liveBuild": false,
    "path": "input"
  },
  "output": {"fileFormat": "root", "path": "output"}
}
