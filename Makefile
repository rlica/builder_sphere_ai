CPP = g++

SOURCE_DIR := src

# ---------------------------------------------------------------------------
# Cap'n Proto generated code
#
# include/eventProto.capnp.h and src/eventProto.capnp.c++ are generated by
# `capnp compile` and are deliberately NOT tracked in git.  They embed a hard
#     #if CAPNP_VERSION != <n>
#     #error "Version mismatch between generated code and library headers."
# guard, so they only compile against the exact capnproto version that produced
# them.  capnp_sync.sh regenerates them when the schema changes or when the
# locally installed capnproto differs from the one that generated them, which
# keeps `make` working on any machine (0.8.x, 1.x, ...) without pinning the
# repository to a single release.
# ---------------------------------------------------------------------------
CAPNP ?= capnp
CAPNP_SCHEMA := eventProto.capnp
CAPNP_HEADER := include/$(CAPNP_SCHEMA).h
CAPNP_SOURCE := $(SOURCE_DIR)/$(CAPNP_SCHEMA).c++
CAPNP_STAMP := $(SOURCE_DIR)/.$(CAPNP_SCHEMA).stamp

CAPNP_CFLAGS := $(shell pkg-config --cflags capnp 2>/dev/null)
CAPNP_LIBS := $(shell pkg-config --libs capnp-rpc 2>/dev/null)
ifeq ($(strip $(CAPNP_LIBS)),)
CAPNP_LIBS := -lcapnp-rpc -lcapnp -lkj-async -lkj
endif

INCLUDE = -I$(ROOT_BASE)/include
INCLUDE += -Iinclude
INCLUDE += $(CAPNP_CFLAGS)

LIBS = -L$(ROOT_BASE)/lib


LDLIBS = -lTree -lRIO -lCore -lHist -pthread -fopenmp -ltbb $(CAPNP_LIBS) -g
#LDLIBS = `root-config --cflags --glibs` -fopenmp -lcapnp -lkj

SOURCE_CPP := $(wildcard $(SOURCE_DIR)/*.cpp)
# The generated .c++ is listed explicitly: $(wildcard) is evaluated when this
# file is parsed, i.e. before capnp_sync.sh has had a chance to create it on a
# fresh checkout.
SOURCE_C++ := $(filter-out $(CAPNP_SOURCE),$(wildcard $(SOURCE_DIR)/*.c++)) $(CAPNP_SOURCE)

OBJECTS := $(patsubst $(SOURCE_DIR)/%.cpp,$(SOURCE_DIR)/%.o,$(SOURCE_CPP))
OBJECTS += $(patsubst $(SOURCE_DIR)/%.c++,$(SOURCE_DIR)/%.o,$(SOURCE_C++))

FLAGS = -std=c++17 -O3 -march=native


all: $(OBJECTS)
	$(CPP)  dispacher.cpp $^ $(INCLUDE) $(LIBS) $(FLAGS) $(LDLIBS) -o build
	$(CPP)  builder.cpp $^ $(INCLUDE) $(LIBS) $(FLAGS) $(LDLIBS) -o builder

# Regenerate the Cap'n Proto sources if needed, then make sure they exist before
# anything tries to compile them.
$(OBJECTS): | $(CAPNP_STAMP)

$(SOURCE_DIR)/%.o: $(SOURCE_DIR)/%.cpp $(CAPNP_HEADER)
	$(CPP) $(INCLUDE) -c $< -o $@ $(FLAGS)

$(SOURCE_DIR)/%.o: $(SOURCE_DIR)/%.c++ $(CAPNP_HEADER)
	$(CPP) $(INCLUDE) -c $< -o $@ $(FLAGS)


.PHONY: cap capnp-check capnp-sync FORCE

# Force regeneration of the Cap'n Proto code (e.g. after editing the schema).
cap:
	@CAPNP='$(CAPNP)' CAPNP_HEADER='$(CAPNP_HEADER)' CAPNP_SOURCE='$(CAPNP_SOURCE)' \
		CAPNP_CFLAGS='$(CAPNP_CFLAGS)' bash ./capnp_sync.sh --force $(CAPNP_SCHEMA)
	@echo "Cap'n Proto sources regenerated in $(CAPNP_HEADER) and $(CAPNP_SOURCE)"

# Report the capnproto compiler version, the library version actually used for
# compilation, and the version the generated code came from.
capnp-check:
	@CAPNP='$(CAPNP)' CAPNP_HEADER='$(CAPNP_HEADER)' CAPNP_SOURCE='$(CAPNP_SOURCE)' \
		CAPNP_CFLAGS='$(CAPNP_CFLAGS)' bash ./capnp_sync.sh --check $(CAPNP_SCHEMA)

capnp-sync:
	@CAPNP='$(CAPNP)' CAPNP_HEADER='$(CAPNP_HEADER)' CAPNP_SOURCE='$(CAPNP_SOURCE)' \
		CAPNP_CFLAGS='$(CAPNP_CFLAGS)' bash ./capnp_sync.sh $(CAPNP_SCHEMA) $(CAPNP_STAMP)

# FORCE keeps the sync running on every build: the script itself is a fast
# no-op when the schema and the installed capnproto already match what is on
# disk, so incremental builds stay incremental.
FORCE:

$(CAPNP_STAMP): FORCE
	@$(MAKE) --no-print-directory capnp-sync
	@touch $@

$(CAPNP_HEADER) $(CAPNP_SOURCE): $(CAPNP_STAMP)
	@if [ ! -f '$@' ]; then \
		echo "capnp_sync: '$@' missing, forcing regeneration"; \
		rm -f '$(CAPNP_STAMP)'; \
		$(MAKE) --no-print-directory capnp-sync; \
	fi

clean:
	@rm -rf $(SOURCE_DIR)/*.o $(CAPNP_STAMP) builder build
